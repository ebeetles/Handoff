{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff/track_analysis/v4",
  "title": "TrackAnalysis",
  "description": "Per-track analysis written by pipeline/ and read by web/. Bump schema_version on any breaking change and update BOTH sides plus contracts/fixtures/.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "artist",
    "source",
    "audio",
    "sample_rate",
    "duration_s",
    "tempo",
    "beats",
    "beats_per_bar",
    "first_downbeat_index",
    "downbeat_confidence",
    "bars",
    "phrase_bars",
    "phrases",
    "sections",
    "cues",
    "hooks",
    "key",
    "waveform",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "filename",
        "license",
        "credit"
      ],
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "credit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "mix",
        "stems",
        "stems_gain_db"
      ],
      "additionalProperties": false,
      "properties": {
        "mix": {
          "type": "string",
          "description": "Path relative to the track folder. Lossless (FLAC) so there is no encoder delay shifting the beat grid."
        },
        "stems": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "drums",
                "bass",
                "vocals",
                "other"
              ],
              "additionalProperties": false,
              "properties": {
                "drums": {
                  "type": "string"
                },
                "bass": {
                  "type": "string"
                },
                "vocals": {
                  "type": "string"
                },
                "other": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "stems_gain_db": {
          "type": [
            "number",
            "null"
          ],
          "description": "Gain (dB) to play the stems at so they add back up to the mix: 0 for provided stems, the separation headroom (6) for Demucs stems. null when there are no stems."
        }
      }
    },
    "sample_rate": {
      "type": "integer",
      "description": "Sample rate of the served audio files."
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tempo": {
      "type": "object",
      "required": [
        "bpm",
        "ibi_cv",
        "max_drift_ms",
        "beatmatchable",
        "grid"
      ],
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "60 / b for the best constant grid t_i = a + b*i over the whole track."
        },
        "ibi_cv": {
          "type": "number",
          "minimum": 0,
          "description": "Coefficient of variation of the raw beat tracker's inter-beat intervals: std(dt)/mean(dt). Informational only."
        },
        "max_drift_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Largest |offset| between the constant grid and the kick, over 8-bar segments that have an on-beat kick. null if no segment has one."
        },
        "beatmatchable": {
          "type": "boolean",
          "description": "max_drift_ms is not null and <= 10 ms: the constant grid holds the kick across the track."
        },
        "grid": {
          "enum": [
            "regular",
            "tracked"
          ],
          "description": "regular = beats are the constant grid; tracked = raw tracker output (used when not beatmatchable)."
        }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 8,
      "description": "Beat times in seconds, strictly increasing."
    },
    "beats_per_bar": {
      "const": 4
    },
    "first_downbeat_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "downbeat_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "beat_index",
          "start_s",
          "energy",
          "rms_db"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "beat_index": {
            "type": "integer",
            "minimum": 0
          },
          "start_s": {
            "type": "number"
          },
          "energy": {
            "type": "object",
            "required": [
              "low",
              "mid",
              "high"
            ],
            "additionalProperties": false,
            "description": "Band energy normalized 0..1 within this track.",
            "properties": {
              "low": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "mid": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "high": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "rms_db": {
            "type": "number",
            "description": "Absolute bar loudness in dBFS, comparable across tracks."
          },
          "stems": {
            "type": "object",
            "required": [
              "drums",
              "bass",
              "vocals",
              "other"
            ],
            "additionalProperties": false,
            "description": "Only when the track has stems: each stem's level against the mix in this bar, 0 (-24 dB or less) to 1 (-14 dB or more).",
            "properties": {
              "drums": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bass": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "vocals": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "other": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "phrase_bars": {
      "type": "integer",
      "minimum": 1
    },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "start_bar",
          "n_bars",
          "start_s",
          "section_index"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "start_bar": {
            "type": "integer",
            "minimum": 0
          },
          "n_bars": {
            "type": "integer",
            "minimum": 1
          },
          "start_s": {
            "type": "number"
          },
          "section_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "start_bar",
          "end_bar",
          "start_s",
          "label",
          "energy_level",
          "vocals",
          "group"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "start_bar": {
            "type": "integer",
            "minimum": 0
          },
          "end_bar": {
            "type": "integer",
            "minimum": 1,
            "description": "Exclusive."
          },
          "start_s": {
            "type": "number"
          },
          "label": {
            "enum": [
              "intro",
              "verse",
              "build",
              "drop",
              "chorus",
              "breakdown",
              "main",
              "outro"
            ],
            "description": "intro/outro: quieter first/last section. build: rising into a peak. drop: a peak after a build, breakdown or energy jump. chorus: a sung peak that recurs. breakdown: the drums drop out. verse: sung, below peak. main: anything else. Rule-based (pipeline/handoff_pipeline/structure.py)."
          },
          "energy_level": {
            "enum": [
              "low",
              "mid",
              "high"
            ]
          },
          "vocals": {
            "enum": [
              "none",
              "some",
              "lots",
              "unknown"
            ],
            "description": "Vocal stem presence over the section; unknown without stems."
          },
          "group": {
            "type": "integer",
            "minimum": 0,
            "description": "Repetition class: sections that sound alike share a group, numbered in order of first appearance."
          }
        }
      }
    },
    "key": {
      "type": "object",
      "required": [
        "name",
        "camelot",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "camelot": {
          "type": "string",
          "pattern": "^(1[0-2]|[1-9])[AB]$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "waveform": {
      "type": "string",
      "description": "Path to waveform JSON relative to the track folder."
    },
    "meta": {
      "type": "object",
      "required": [
        "pipeline_version",
        "generated_at",
        "overrides_applied"
      ],
      "additionalProperties": false,
      "properties": {
        "pipeline_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "overrides_applied": {
          "type": "object"
        }
      }
    },
    "cues": {
      "type": "array",
      "description": "Moments, in bars: where a drop or chorus hits (drop), the rising bars before it (build), breakdowns, and where vocals enter or stop.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "bar",
          "bars"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "drop",
              "build",
              "breakdown",
              "vocal_in",
              "vocal_out"
            ]
          },
          "bar": {
            "type": "integer",
            "minimum": 0
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "description": "The most repeated 2- or 4-bar phrase of the vocal stem (vocal) and the other stem (instrumental), with every bar it starts at (non-overlapping). Empty if nothing repeats 3 times.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "bars",
          "starts",
          "strength"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "vocal",
              "instrumental"
            ]
          },
          "bars": {
            "enum": [
              2,
              4
            ]
          },
          "starts": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "strength": {
            "type": "number",
            "description": "Mean similarity of the repeats (0..1)."
          }
        }
      }
    }
  }
}
